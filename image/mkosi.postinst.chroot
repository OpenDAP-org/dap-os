#!/bin/sh
# Blackbird OS identity (ADR 0011): os-release and the console banner.
# Debian's os-release is diverted, so a base-files upgrade cannot put "Debian" back.
set -eu

# --no-rename: base-files is Essential, so its file stays in place and is overwritten below; upgrades write to the diversion.
dpkg-divert --quiet --local --no-rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
cat > /usr/lib/os-release <<'OS'
NAME="Blackbird OS"
PRETTY_NAME="Blackbird OS (development)"
ID=blackbird
ID_LIKE=debian
VERSION="development"
HOME_URL="https://github.com/opendap-project/blackbird-os"
SUPPORT_URL="https://github.com/opendap-project/blackbird-os"
BUG_REPORT_URL="https://github.com/opendap-project/blackbird-os/issues"
OS
ln -sf ../usr/lib/os-release /etc/os-release

printf 'Blackbird OS \\n \\l\n\n' > /etc/issue
printf 'Blackbird OS\n' > /etc/issue.net

# Login message: Debian's says "Debian GNU/Linux"; keep its licence and warranty notice, under our name.
cat > /etc/motd <<'MOTD'

Blackbird OS is built on Debian GNU/Linux. The programs included with it are
free software; the exact distribution terms for each program are described in
the individual files in /usr/share/doc/*/copyright.

Blackbird OS comes with ABSOLUTELY NO WARRANTY, to the extent permitted by
applicable law.
MOTD
