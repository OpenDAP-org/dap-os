# The Blackbird OS session (system ADR 0002): dap-shell on the first virtual terminal, as the `dap`
# user, in a logind session opened through PAM, so libseat gets the display and input devices
# from logind. Until the orchestrator starts activities, the shell starts the product host.
# The binaries come from Blackbird OS packages, or from a development system extension
# (/var/lib/extensions) during development.
[Unit]
Description=Blackbird OS shell
ConditionPathExists=/usr/bin/dap-shell
After=systemd-user-sessions.service systemd-logind.service systemd-sysext.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=dap
PAMName=dap-shell
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
ExecStart=/usr/bin/dap-shell -- /usr/bin/dap-product
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
